# ==============================================================================
# NAIRATEE STORES - ENVIRONMENT CONFIGURATION
# ==============================================================================

NODE_ENV=development
PORT=4001

# 1. Admin Control Dashboard Secret
ADMIN_API_KEY=nairatee_admin_secret_2026

# 2. BotSailor WhatsApp Cloud API Gateway
BOTSAILOR_BASE_URL=https://use.botsailor.com/api/v1
BOTSAILOR_API_KEY=mock-botsailor-api-key
BOTSAILOR_WHATSAPP_BOT_ID=mock-bot-id

# 3. Supabase PostgreSQL Database (Catalog, Variants, Orders)
SUPABASE_URL=https://mock-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=mock-supabase-key
SUPABASE_ANON_KEY=mock-supabase-anon-key

# 4. Store Branding & Official Bank Transfer Details
STORE_NAME=Nairatee Stores
BANK_NAME=Access Bank
BANK_ACCOUNT_NUMBER=0123456789
BANK_ACCOUNT_NAME=Nairatee Stores Enterprise
SUPPORT_PHONE_NUMBER=2348000000000

# 5. Authorized Admin Phone Numbers for WhatsApp /add command (comma-separated, with country code e.g. 234...)
ADMIN_PHONES=2348000000000
